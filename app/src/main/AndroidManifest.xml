<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- スケジュール・カレンダーパネル：端末のカレンダーの予定を読む（読み取りのみ） -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- 音楽波形：Visualizer で出力音声を解析するために必要（録音はしない） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- EQ・Visualizer：オーディオエフェクトの適用 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- ターミナルのファイル操作：内部ストレージ全体へのアクセス -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- 稼働状況：最近使ったアプリと使用時間 -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- 通信パネル：接続状態・Wi-Fi 情報・SSID（位置情報）・回線種別（電話の状態） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- カメラ・ライトは必須ではない（無い端末でもインストール可能） -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- ランチャーに表示されるアプリ（MAIN + LAUNCHER）を取得可能にする -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- camera コマンド -->
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <!-- ターミナルの open：ファイルを開けるアプリ -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".IhlApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="IHL"
        android:supportsRtl="true"
        android:theme="@style/Theme.IcHomeLauncher">

        <!-- ホームアプリとして認識させる設定 -->
        <!-- ※仕様書にある android:resumeWhilePaused は公開 SDK に存在しない非公開属性で
             リソースリンクがエラーになるため指定していない（システム製ランチャー専用） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="IHL"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.IcHomeLauncher"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- ホームアプリ候補として表示される -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 通知リスナー：通知履歴の記録と、再生中メディアの取得に使う（「通知へのアクセス」の許可が必要） -->
        <service
            android:name=".service.IhlNotificationListener"
            android:exported="true"
            android:label="IHL"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- ターミナルの open：ファイルを他アプリへ渡す -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
